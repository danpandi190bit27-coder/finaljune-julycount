class Solution {
    public int fib(int n) {
        // Base cases: F(0) = 0 and F(1) = 1
        if (n == 0) return 0;
        if (n == 1) return 1;
        
        // Variables to keep track of the last two numbers
        int first = 0;
        int second = 1;
        int current = 0;
        
        // Loop from 2 up to n to find the sum of the last two numbers
        for (int i = 2; i <= n; i++) {
            current = first + second; // Sum the preceding two numbers
            first = second;           // Move second to first
            second = current;         // Move current to second
        }
        
        return current;
    }
}
