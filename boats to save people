#include <stdio.h>
#include <stdlib.h>

// Helper function to sort numbers in ascending order
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

int numRescueBoats(int* people, int peopleSize, int limit) {
    // 1. Sort the weights from lightest to heaviest
    qsort(people, peopleSize, sizeof(int), compare);
    
    int light = 0;
    int heavy = peopleSize - 1;
    int boats = 0;
    
    // 2. Pair people using two pointers
    while (light <= heavy) {
        // If the lightest and heaviest person fit together
        if (people[light] + people[heavy] <= limit) {
            light++;
        }
        // The heaviest person always takes a boat
        heavy--;
        boats++;
    }
    
    return boats;
}
